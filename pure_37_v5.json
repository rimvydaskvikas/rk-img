: "0", "bottom": "0", "left": "0", "isLinked": true}, "align": "center"}, "elements": []}], "isInner": false}], "isInner": false}, {"id": "575f1f9", "elType": "container", "settings": {"content_width": "full", "html_tag": "div", "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "padding": {"unit": "px", "top": "0", "right": "20", "bottom": "0", "left": "20", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "0", "right": "18", "bottom": "0", "left": "18", "isLinked": false}, "flex_direction": "column", "flex_wrap": "nowrap", "container_type": "flex", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "background_background": "classic", "background_color": "rgb(255, 255, 255)", "position": "relative"}, "elements": [{"id": "4efd25d", "elType": "container", "settings": {"content_width": "boxed", "html_tag": "div", "flex_gap": {"column": "20", "row": "20", "isLinked": true, "unit": "px", "size": 20}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "flex_direction": "column", "flex_wrap": "nowrap", "flex_wrap_mobile": "wrap", "container_type": "flex", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "boxed_width": {"unit": "px", "size": 820.0, "sizes": []}, "position": "relative"}, "elements": [{"id": "9db2d81", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<h2 style=\"font-family:Manrope;font-size:36px;font-weight:800;line-height:43.2px;color:rgb(22, 101, 52);margin:36px 0px 12px;letter-spacing:normal;text-transform:none\">Bendrosios nuostatos</h2><p style=\"font-family:Inter;font-size:16.5px;font-weight:400;line-height:29.7px;color:rgb(100, 116, 139);margin:0px 0px 14.4px;letter-spacing:normal;text-transform:none\">Ši privatumo politika paaiškina, kokius asmens duomenis renka RAKTŲ MEISTRAS, kokiu tikslu\njie tvarkomi ir kokias teises turi svetainės lankytojai.</p><h2 style=\"font-family:Manrope;font-size:36px;font-weight:800;line-height:43.2px;color:rgb(22, 101, 52);margin:36px 0px 12px;letter-spacing:normal;text-transform:none\">Kokius duomenis renkame</h2><p style=\"font-family:Inter;font-size:16.5px;font-weight:400;line-height:29.7px;color:rgb(100, 116, 139);margin:0px 0px 14.4px;letter-spacing:normal;text-transform:none\">Kai užpildote užklausos formą, prašome nurodyti vardą, telefono numerį, el. pašto adresą,\npasirinkti paslaugą ir aprašyti problemą. Šie duomenys reikalingi tam, kad galėtume su Jumis\nsusisiekti ir pateikti pasiūlymą.</p><h2 style=\"font-family:Manrope;font-size:36px;font-weight:800;line-height:43.2px;color:rgb(22, 101, 52);margin:36px 0px 12px;letter-spacing:normal;text-transform:none\">Kaip naudojame duomenis</h2><p style=\"font-family:Inter;font-size:16.5px;font-weight:400;line-height:29.7px;color:rgb(100, 116, 139);margin:0px 0px 14.4px;letter-spacing:normal;text-transform:none\">Pateiktus duomenis naudojame tik atsakymui į Jūsų užklausą ir paslaugos suteikimui.\nDuomenų neperduodame trečiosioms šalims rinkodaros tikslais ir nenaudojame jų reklaminiams\npranešimams be atskiro Jūsų sutikimo.</p><h2 style=\"font-family:Manrope;font-size:36px;font-weight:800;line-height:43.2px;color:rgb(22, 101, 52);margin:36px 0px 12px;letter-spacing:normal;text-transform:none\">Saugojimo terminas</h2><p style=\"font-family:Inter;font-size:16.5px;font-weight:400;line-height:29.7px;color:rgb(100, 116, 139);margin:0px 0px 14.4px;letter-spacing:normal;text-transform:none\">Užklausų duomenis saugome tiek, kiek reikia susirašinėjimui užbaigti ir paslaugai suteikti,\nbet ne ilgiau nei tai būtina pagal teisės aktų reikalavimus.</p><h2 style=\"font-family:Manrope;font-size:36px;font-weight:800;line-height:43.2px;color:rgb(22, 101, 52);margin:36px 0px 12px;letter-spacing:normal;text-transform:none\">Slapukai</h2><p style=\"font-family:Inter;font-size:16.5px;font-weight:400;line-height:29.7px;color:rgb(100, 116, 139);margin:0px 0px 14.4px;letter-spacing:normal;text-transform:none\">Svetainėje gali būti naudojami techniniai slapukai, būtini jos veikimui, bei statistiniai\nslapukai lankomumui matuoti. Slapukų naudojimą galite valdyti savo naršyklės nustatymuose.</p><h2 style=\"font-family:Manrope;font-size:36px;font-weight:800;line-height:43.2px;color:rgb(22, 101, 52);margin:36px 0px 12px;letter-spacing:normal;text-transform:none\">Jūsų teisės</h2><p style=\"font-family:Inter;font-size:16.5px;font-weight:400;line-height:29.7px;color:rgb(100, 116, 139);margin:0px 0px 14.4px;letter-spacing:normal;text-transform:none\">Turite teisę susipažinti su savo duomenimis, prašyti juos ištaisyti ar ištrinti, apriboti\njų tvarkymą arba nesutikti su tvarkymu. Dėl to kreipkitės el. paštu info@raktumeistras.lt.</p><h2 style=\"font-family:Manrope;font-size:36px;font-weight:800;line-height:43.2px;color:rgb(22, 101, 52);margin:36px 0px 12px;letter-spacing:normal;text-transform:none\">Kontaktai</h2><p style=\"font-family:Inter;font-size:16.5px;font-weight:400;line-height:29.7px;color:rgb(100, 116, 139);margin:0px 0px 14.4px;letter-spacing:normal;text-transform:none\">RAKTŲ MEISTRAS<br>Savanorių pr. 187, Kaunas<br>Tel. +370 600 12345<br>El. paštas: info@raktumeistras.lt</p>", "text_color": "rgb(22, 101, 52)", "typography_typography": "custom", "typography_font_family": "Manrope", "typography_font_size": {"unit": "px", "size": 36.0, "sizes": []}, "typography_font_weight": "800", "typography_letter_spacing": {"unit": "px", "size": 0.0, "sizes": []}, "typography_line_height": {"unit": "px", "size": 43.2, "sizes": []}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "__globals__": {"typography_typography": "", "text_color": ""}}, "elements": []}], "isInner": false}], "isInner": false}]